---
layout: base.njk
title: Recipes
permalink: /index.html
eleventyExcludeFromCollections: true
---
{% macro card(item) %}
<a class="card" href="{{ item.url | url }}"
   data-tags="{{ (item.data.tags or []) | join(',') }}"
   data-title="{{ item.data.title }}">
  {% if item.data.image %}
  <div class="card-thumb">
    <img src="{{ item.data.image | url }}" alt="{{ item.data.image_alt or item.data.title }}" loading="lazy">
  </div>
  {% endif %}
  <div class="card-body">
    <h3>{{ item.data.title }}</h3>
    {% set m = item.data.macros %}
    {% if item.data.time_total or item.data.rating or (m and m.calories is defined and m.calories != null) %}
    <p class="card-meta">
      {%- if m and m.calories is defined and m.calories != null %}<span class="card-macro">{{ m.calories }} cal</span>{% endif -%}
      {%- if m and m.protein %}<span class="card-macro">{{ m.protein }} protein</span>{% endif -%}
      {%- if item.data.time_total %}<span>{{ item.data.time_total }} min</span>{% endif -%}
      {%- if item.data.rating %}<span class="stars" aria-label="{{ item.data.rating }} out of 5">
        {%- for i in range(1, 6) -%}
          <span class="star{% if i <= item.data.rating %} star-on{% endif %}" aria-hidden="true">★</span>
        {%- endfor -%}
      </span>{% endif -%}
    </p>
    {% endif %}
    {% if item.data.source %}
    <p class="card-source">
      {%- if item.data.source | isUrl -%}
        {{ item.data.source | displayUrl }}
      {%- elif item.data.source == "original" -%}
        Original recipe
      {%- else -%}
        {{ item.data.source }}
      {%- endif -%}
    </p>
    {% endif %}
    <div class="pills">
      {% for t in (item.data.tags or []) %}<span class="pill pill-tag">{{ t }}</span>{% endfor %}
    </div>
  </div>
</a>
{% endmacro %}

<div class="toolbar">
  <div class="search-wrap">
    <input type="search" id="searchInput" placeholder="Search recipes and techniques…" aria-label="Search recipes and techniques" autocomplete="off">
  </div>
  <div class="tag-filters" id="tagFilters"></div>
</div>

<div class="collection-block">
  <h2 class="section-heading">Recipes</h2>
  {% set recipesByCategory = collections.recipe | groupByCategory %}
  {% for category, items in recipesByCategory %}
  <section class="category-group" data-category="{{ category }}">
    <h3 class="category-heading">{{ category | categoryName }}</h3>
    <div class="card-grid">
      {% for item in items %}{{ card(item) }}{% endfor %}
    </div>
  </section>
  {% endfor %}
</div>

<div class="collection-block">
  <h2 class="section-heading">Techniques</h2>
  <section class="category-group" data-category="technique">
    <div class="card-grid">
      {% for item in (collections.technique | sortByTitle) %}{{ card(item) }}{% endfor %}
    </div>
  </section>
</div>

<p id="noResults" class="no-results" hidden>No matches. Try a different search or clear the tag filters.</p>
