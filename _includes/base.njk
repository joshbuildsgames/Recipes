<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#b5482f">
<title>{% if title %}{{ title }} · {% endif %}Recipe Box</title>
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
<header class="site-header">
  <a href="{{ '/' | url }}" class="site-title">
    <span class="site-mark" aria-hidden="true"></span>
    Recipe Box
  </a>
  <button type="button" class="sync-btn" id="syncBtn" hidden>Sync</button>
</header>

<div class="sync-panel" id="syncPanel" hidden>
  <div class="sync-card">
    <h2>Sync favorites</h2>
    <div id="syncSignedOut">
      <p class="sync-copy">
        Sign in to keep favorites and hidden recipes in step across your phone and
        laptop. You'll get a one-time link by email — no password.
      </p>
      <form>
        <label class="sync-label" for="syncEmail">Email</label>
        <input type="email" id="syncEmail" required autocomplete="email" placeholder="you@example.com">
        <button type="submit" class="sync-submit">Send sign-in link</button>
      </form>
    </div>
    <div id="syncSignedIn" hidden>
      <p class="sync-copy">Synced as <strong id="syncWho"></strong>.</p>
      <button type="button" class="sync-submit is-secondary" id="syncSignOut">Sign out</button>
    </div>
    <p class="sync-message" id="syncMessage" hidden></p>
  </div>
</div>

<main class="site-main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <p>Personal cookbook &middot; built with Eleventy</p>
</footer>
<script src="{{ '/js/supabase-config.js' | url }}"></script>
<script src="{{ '/js/store.js' | url }}" defer></script>
<script src="{{ '/js/app.js' | url }}" defer></script>
</body>
</html>
