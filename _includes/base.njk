<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#b5482f">
<title>{% if title %}{{ title }} · {% endif %}Recipe Box</title>
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
<header class="site-header">
  <a href="{{ '/' | url }}" class="site-title">
    <span class="site-mark" aria-hidden="true"></span>
    Recipe Box
  </a>
</header>
<main class="site-main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <p>Personal cookbook &middot; built with Eleventy</p>
</footer>
<script src="{{ '/js/app.js' | url }}" defer></script>
</body>
</html>
