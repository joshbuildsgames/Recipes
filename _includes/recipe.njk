---
layout: base.njk
---
<article class="detail">
  <a class="back-link" href="{{ '/' | url }}">
    <span aria-hidden="true">&larr;</span> All recipes
  </a>

  {% if image %}
  <figure class="hero">
    <img src="{{ image | url }}" alt="{{ image_alt or title }}" loading="lazy">
  </figure>
  {% endif %}

  <h1>{{ title }}</h1>

  {% if time_total or servings or rating %}
  <div class="meta-bar">
    {% if time_total %}
    <span class="meta-item">
      <span class="meta-label">Time</span>
      <span class="meta-value">{{ time_total }} min</span>
    </span>
    {% endif %}
    {% if servings %}
    <span class="meta-item">
      <span class="meta-label">Serves</span>
      <span class="meta-value">{{ servings }}</span>
    </span>
    {% endif %}
    {% if rating %}
    <span class="meta-item">
      <span class="meta-label">Rating</span>
      <span class="meta-value stars" aria-label="{{ rating }} out of 5">
        {%- for i in range(1, 6) -%}
          <span class="star{% if i <= rating %} star-on{% endif %}" aria-hidden="true">★</span>
        {%- endfor -%}
      </span>
    </span>
    {% endif %}
  </div>
  {% endif %}

  {% if source %}
  <p class="source-line">
    <span class="source-label">Source</span>
    {% if source | isUrl %}
      <a href="{{ source }}" rel="noopener noreferrer" target="_blank">{{ source | displayUrl }}</a>
    {% elif source == "original" %}
      <span class="source-original">Original recipe</span>
    {% else %}
      <span>{{ source }}</span>
    {% endif %}
  </p>
  {% endif %}

  {% if macros and macros.calories is defined and macros.calories != null %}
  <section class="macros" aria-label="Nutrition per serving">
    <header class="macros-head">
      <h2>Macros</h2>
      <span class="macros-basis{% if macros.basis == 'estimated' %} is-estimated{% endif %}">
        {%- if macros.basis == "estimated" %}Estimated{% else %}Per serving{% endif -%}
      </span>
    </header>
    <div class="macro-grid">
      <div class="macro"><span class="macro-value">{{ macros.calories }}</span><span class="macro-key">cal</span></div>
      <div class="macro"><span class="macro-value">{{ macros.protein }}</span><span class="macro-key">protein</span></div>
      <div class="macro"><span class="macro-value">{{ macros.carbs }}</span><span class="macro-key">carbs</span></div>
      <div class="macro"><span class="macro-value">{{ macros.fat }}</span><span class="macro-key">fat</span></div>
    </div>
    {% if macros.serving_size %}<p class="macro-note">Serving size: {{ macros.serving_size }}</p>{% endif %}
    {% if macros.note %}<p class="macro-note">{{ macros.note }}</p>{% endif %}
  </section>
  {% endif %}

  {% if cookware and cookware.length or tags and tags.length %}
  <div class="pills">
    {% for c in cookware %}<span class="pill pill-cookware">{{ c }}</span>{% endfor %}
    {% for t in tags %}<span class="pill pill-tag">{{ t }}</span>{% endfor %}
  </div>
  {% endif %}

  <div class="markdown-content">
    {{ content | stripLeadingH1 | safe }}
  </div>
</article>
